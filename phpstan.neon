includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
        - database/
        - routes/
        - tests/
    level: 6
    checkMissingIterableValueType: false
    ignoreErrors:
        - '#PHPDoc tag @var#'
    excludePaths:
        - vendor/*
        - bootstrap/cache/*
        - storage/*
